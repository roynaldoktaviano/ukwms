# === Mode ===
# true  -> jalan tanpa backend (memakai data dummy + login demo)
# false -> memakai backend Python + SSO sungguhan
NEXT_PUBLIC_USE_MOCK=true

# === Backend Python (dipakai saat NEXT_PUBLIC_USE_MOCK=false) ===
# Base URL REST API kamu, mis. http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# === SSO ===
# Endpoint backend yang memulai alur SSO (redirect ke Identity Provider).
# Frontend hanya mengarahkan ke sini; backend yang bicara dengan IdP.
NEXT_PUBLIC_SSO_LOGIN_URL=http://localhost:8000/api/auth/sso/login
NEXT_PUBLIC_SSO_LOGOUT_URL=http://localhost:8000/api/auth/sso/logout
